{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "maxSize": 4194304,
    "includes": [
      "**",
      "!**/dist",
      "!docs/.vitepress/cache",
      "!.claude",
      "!graphify-out",
      "!bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": { "noExplicitAny": "error" },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "decimal.js": "Import Decimal from \"@smartput/core\" (or, inside packages/core, from \"./decimal\") instead of \"decimal.js\" directly. A raw import bypasses the Decimal.set({ precision: 28, ... }) configuration that packages/core/src/decimal.ts applies as a module-load side effect, silently running at decimal.js's ~20-digit default and producing wrong numbers with no error."
            }
          }
        }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/decimal.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
