{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@smartput/core": ["../packages/core/src/index.ts"],
      "@smartput/locale-en": ["../packages/locale-en/src/index.ts"]
    }
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue", "unocss.config.ts"]
}
