# Lab telemetry. Copy to `docs/.env.local` for local development, and set the
# same two names in the Vercel project for Preview and Production.
#
# Both are public: this is a static site, so anything the browser needs ships in
# the bundle. That is safe only because `lab_events` has an insert-only RLS
# policy — see supabase/migrations. The anon key is published, not secret. The
# service-role key must never appear in this file or anywhere under docs/.
#
# Leave them unset and the Lab still works; the report button just says so.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Optional. Stamped onto every filed row so a report can be tied to a build.
# On Vercel, set it to $VERCEL_GIT_COMMIT_SHA.
VITE_APP_VERSION=
