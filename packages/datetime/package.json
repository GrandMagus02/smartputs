{
  "name": "@smartput/datetime",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./holiday": {
      "bun": "./src/holiday.ts",
      "types": "./dist/holiday.d.ts",
      "default": "./dist/holiday.js"
    },
    "./locale/en": {
      "bun": "./src/locale/en.ts",
      "types": "./dist/locale/en.d.ts",
      "default": "./dist/locale/en.js"
    }
  },
  "dependencies": {
    "@smartput/core": "workspace:*",
    "@smartput/holiday": "workspace:*",
    "@smartput/timezone": "workspace:*",
    "chrono-node": "^2.9.0",
    "decimal.js": "^10.6.0",
    "temporal-polyfill": "^0.3.0"
  },
  "devDependencies": {
    "@smartput/country": "workspace:*",
    "@smartput/kinds": "workspace:*"
  }
}
