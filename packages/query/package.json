{
  "name": "@smartput/query",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sql": {
      "bun": "./src/sql.ts",
      "types": "./dist/sql.d.ts",
      "default": "./dist/sql.js"
    },
    "./mongo": {
      "bun": "./src/mongo.ts",
      "types": "./dist/mongo.d.ts",
      "default": "./dist/mongo.js"
    }
  },
  "dependencies": {
    "@smartput/core": "workspace:*",
    "@smartput/kind": "workspace:*"
  },
  "devDependencies": {
    "@smartput/core": "workspace:*",
    "@smartput/date": "workspace:*",
    "@smartput/date-range": "workspace:*",
    "@smartput/datetime": "workspace:*",
    "@smartput/geo": "workspace:*",
    "@smartput/kinds": "workspace:*",
    "@smartput/rate": "workspace:*"
  }
}
