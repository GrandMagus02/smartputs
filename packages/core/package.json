{
  "name": "@smartput/core",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "./src/decimal.ts",
    "./dist/index.js",
    "./dist/locale/en.js",
    "./dist/testing/index.js",
    "./dist/tokenize.js",
    "./dist/parse.js",
    "./dist/solve.js",
    "./dist/eval.js",
    "./dist/print.js",
    "./dist/registry.js"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/en": {
      "bun": "./src/locale/en.ts",
      "types": "./dist/locale/en.d.ts",
      "default": "./dist/locale/en.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./normalize": {
      "bun": "./src/normalize.ts",
      "types": "./dist/normalize.d.ts",
      "default": "./dist/normalize.js"
    },
    "./tokenize": {
      "bun": "./src/tokenize.ts",
      "types": "./dist/tokenize.d.ts",
      "default": "./dist/tokenize.js"
    },
    "./parse": {
      "bun": "./src/parse.ts",
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./solve": {
      "bun": "./src/solve.ts",
      "types": "./dist/solve.d.ts",
      "default": "./dist/solve.js"
    },
    "./eval": {
      "bun": "./src/eval.ts",
      "types": "./dist/eval.d.ts",
      "default": "./dist/eval.js"
    },
    "./print": {
      "bun": "./src/print.ts",
      "types": "./dist/print.d.ts",
      "default": "./dist/print.js"
    },
    "./registry": {
      "bun": "./src/registry.ts",
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    }
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@smartput/kinds": "workspace:*",
    "@smartput/shared": "workspace:*"
  }
}
