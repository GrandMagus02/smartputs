    "./freeze": {
      "bun": "./src/freeze.ts",
      "types": "./dist/freeze.d.ts",
      "default": "./dist/freeze.js"
    },
    "./errors": {
      "bun": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
