{
  "name": "@smartput/kinds",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validate": {
      "bun": "./src/validate.ts",
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./class": {
      "bun": "./src/class.ts",
      "types": "./dist/class.d.ts",
      "default": "./dist/class.js"
    }
  },
  "dependencies": {
    "@smartput/angle": "workspace:*",
    "@smartput/area": "workspace:*",
    "@smartput/core": "workspace:*",
    "@smartput/datarate": "workspace:*",
    "@smartput/datasize": "workspace:*",
    "@smartput/duration": "workspace:*",
    "@smartput/energy": "workspace:*",
    "@smartput/length": "workspace:*",
    "@smartput/mass": "workspace:*",
    "@smartput/measure": "workspace:*",
    "@smartput/number": "workspace:*",
    "@smartput/percent": "workspace:*",
    "@smartput/power": "workspace:*",
    "@smartput/speed": "workspace:*",
    "@smartput/temperature": "workspace:*",
    "@smartput/tempo": "workspace:*",
    "@smartput/volume": "workspace:*"
  },
  "devDependencies": {
    "@smartput/locale-en": "workspace:*"
  }
}
