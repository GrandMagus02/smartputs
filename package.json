{
  "name": "smartputs-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "test": "bun test",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "check-deps": "bun run scripts/check-deps.ts",
    "check": "bun run lint && bun run typecheck && bun run check-deps && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.0"
  }
}
