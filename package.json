{
  "name": "smartputs-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "docs:packages": "bun run scripts/gen-package-pages.ts",
    "docs:readmes": "bun run scripts/gen-readmes.ts",
    "docs:dev": "bun run build && bun run docs:packages && bun run --cwd docs dev",
    "docs:build": "bun run build && bun run docs:packages && bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run scripts/typecheck.ts",
    "check-deps": "bun run scripts/check-deps.ts",
    "check-size": "bun run scripts/check-size.ts",
    "parity:record": "bun run scripts/parity-record.ts",
    "check": "bun run lint && bun run typecheck && bun run check-deps && bun test && bun run build && bun run check-size"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.0"
  }
}
